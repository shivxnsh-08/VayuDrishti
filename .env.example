# Copy to .env and fill in. Never commit .env.

# data.gov.in API key (free, from your data.gov.in account)
DATA_GOV_API_KEY=
# Start with one state, e.g. Delhi (VERIFY the exact state name used by the feed). Empty = all.
INGESTION_STATE_FILTER=

# Telegram alerts (optional). Full guide: docs/operations.md#telegram. Never commit real values.
#   TELEGRAM_BOT_TOKEN    = the token @BotFather shows after /newbot (format <digits>:<35 chars>). SECRET.
#   TELEGRAM_BOT_USERNAME = the bot's username WITHOUT "@" (ends in "bot"); the website links to it.
# Empty token = Telegram disabled: the app still runs, linking is unavailable and alerts stay PENDING.
# The backend polls getUpdates: do not set a webhook on this bot, and run only one backend per bot.
# Apply with: docker compose up -d --no-deps backend   (recreates only the backend; data is kept)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional: LLM phrasing for advice. Without it, template messages are used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional: historical backfill from OpenAQ (python -m backfill.openaq). Your own key from explore.openaq.org.
OPENAQ_API_KEY=

# Required: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Dedicated administrator account (created automatically at start-up; signs in on the normal login page and
# sees ONLY the Admin Dashboard and User Management). Use an email that is not a normal VayuDrishti account.
#   ADMIN_PASSWORD: at least 12 characters mixing three of lower/upper/digits/symbols; stored only as a BCrypt
#   hash; changing it later has no effect unless ADMIN_PASSWORD_RESET=true is set for one restart.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true in production: start-up fails if the admin account is missing or its password is weak
ADMIN_REQUIRED=false
# one-off password rotation for the admin account; set back to false after the restart
ADMIN_PASSWORD_RESET=false

# Comma-separated emails that get the ADMIN role when they register. The role is decided at registration
# only: an account registered before its email was listed here stays USER.
# Admins with a linked Telegram chat receive ingestion-health alerts.
ADMIN_EMAILS=

# Database password. Set your own; if left empty, docker-compose.yml falls back to a local development default.
POSTGRES_PASSWORD=

# Grafana admin login (anonymous access is off)
GRAFANA_ADMIN_PASSWORD=

# Swagger UI / OpenAPI docs: true = public, false = ADMIN only
API_DOCS_PUBLIC=true

# Automated ML lifecycle in the forecast service (readiness checks, scheduled training, promotion,
# monitoring, rollback). All LIFECYCLE_* settings are listed in forecast-service/lifecycle/config.py.
LIFECYCLE_ENABLED=true

# Set to false for the "without cache" half of the latency experiment (X7)
CACHE_ENABLED=true
